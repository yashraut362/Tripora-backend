# Copy to .env and adjust. Loaded via `node --env-file-if-exists=.env` in the
# dev/start scripts — no dotenv dependency needed on Node 20+.
PORT=3000

# Local MongoDB by default; swap for an Atlas connection string if you use Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/tripora

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth — create a "Web application" client in Google Cloud Console and
# add http://localhost:3000/api/auth/callback/google as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI — itinerary generation (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
